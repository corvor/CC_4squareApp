# Settings for running the FULL app on your computer.
# The first time you run the full app, this file is copied to .env.local.
# Put your real key in .env.local (never share that file or upload it to GitHub).

# Get a key at https://console.anthropic.com/ (paste it right after the = sign, no spaces)
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-5-5
ANALYSIS_ENABLED=true
RATE_LIMIT_PER_HOUR=20
DAILY_ANALYSIS_LIMIT=300
